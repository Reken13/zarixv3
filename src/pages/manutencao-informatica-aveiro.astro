---
import Layout from '../layouts/Layout.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Manutenção Informática em Aveiro",
    "description": "Manutenção preventiva e corretiva de computadores, servidores e sistemas informáticos em Aveiro.",
    "provider": { "@id": "https://zarix.site/#business" },
    "areaServed": { "@type": "City", "name": "Aveiro" },
    "url": "https://zarix.site/manutencao-informatica-aveiro"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://zarix.site/" },
      { "@type": "ListItem", "position": 2, "name": "Manutenção Informática em Aveiro", "item": "https://zarix.site/manutencao-informatica-aveiro" }
    ]
  }
];
---

<Layout
  title="Manutenção Informática em Aveiro | Zarix"
  description="Manutenção preventiva e corretiva de computadores, servidores e sistemas para empresas em Aveiro. Limpeza, atualizações, diagnóstico e substituição de componentes."
  canonical="https://zarix.site/manutencao-informatica-aveiro"
  schema={schema}
>
  <main class="bg-[#0B0F19] text-slate-100 min-h-screen font-sans selection:bg-blue-500/30 selection:text-blue-200 relative overflow-hidden pt-24 pb-32">

    <div class="absolute inset-0 z-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_30%,#000_60%,transparent_100%)] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="mb-10 font-mono text-xs text-slate-500 flex items-center gap-2">
        <a href="/" class="hover:text-blue-400 transition-colors">Início</a>
        <span>/</span>
        <span class="text-slate-400">Manutenção Informática em Aveiro</span>
      </nav>

      <section class="pb-16 border-b border-slate-800/60 space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950 border border-slate-800 text-xs font-mono text-blue-400 tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          Manutenção // Preventiva & Corretiva
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Manutenção Informática<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-blue-500">
            em Aveiro
          </span>
        </h1>
        <p class="text-slate-400 text-base leading-relaxed max-w-2xl">
          Computadores lentos, sistemas a bloquear e hardware a falhar custam produtividade e dinheiro. A Zarix faz manutenção preventiva e corretiva de equipamentos informáticos em Aveiro — para que a sua equipa trabalhe sem interrupções.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/#contact" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 font-mono text-sm">
            Pedir diagnóstico →
          </a>
          <a href="tel:+351967608772" class="inline-flex items-center gap-2 border border-slate-700 hover:border-blue-500/50 text-slate-300 hover:text-white font-mono text-sm py-3 px-6 rounded-lg transition-all duration-300">
            +351 967 608 772
          </a>
        </div>
      </section>

      <section class="py-16 border-b border-slate-800/60">
        <div class="mb-10 space-y-2">
          <span class="font-mono text-xs text-blue-500 uppercase tracking-widest">// Serviços de manutenção</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white">Do diagnóstico à resolução completa</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { title: "Limpeza e Otimização", desc: "Limpeza interna de pó, substituição de pasta térmica e otimização de software para recuperar desempenho." },
            { title: "Diagnóstico de Hardware", desc: "Análise completa de discos, memória RAM, placas gráficas e componentes para identificar falhas antes de ocorrerem." },
            { title: "Substituição de Componentes", desc: "Substituição de discos por SSDs, upgrade de RAM e outros componentes para prolongar a vida útil dos equipamentos." },
            { title: "Reinstalação de Sistema", desc: "Instalação limpa do Windows ou macOS com todos os drivers e software necessários para o trabalho." },
            { title: "Recuperação de Dados", desc: "Recuperação de ficheiros de discos danificados, formatados ou corrompidos por vírus ou falha de sistema." },
            { title: "Manutenção Programada", desc: "Plano de manutenção periódica para empresas — evita avarias e garante desempenho constante ao longo do ano." },
          ].map(item => (
            <div class="p-6 bg-slate-950/50 border border-slate-800 rounded-xl hover:border-blue-500/30 transition-colors">
              <div class="w-2 h-2 rounded-full bg-blue-500 mb-4"></div>
              <h3 class="text-white font-bold mb-2">{item.title}</h3>
              <p class="text-slate-400 text-sm font-mono leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="py-16 border-b border-slate-800/60">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          {[
            { value: "Local", label: "Técnico em Aveiro — deslocação ao seu espaço" },
            { value: "Rápido", label: "Maioria das reparações resolvida no mesmo dia" },
            { value: "Claro", label: "Orçamento prévio sem surpresas na fatura" },
          ].map(stat => (
            <div class="p-8 bg-slate-950/50 border border-slate-800 rounded-xl">
              <div class="text-2xl font-black text-blue-400 font-mono mb-2">{stat.value}</div>
              <div class="text-slate-400 text-sm font-mono">{stat.label}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="pt-16 text-center space-y-6">
        <h2 class="text-2xl md:text-3xl font-bold text-white">O seu equipamento trabalha — ou avisa antes de falhar</h2>
        <p class="text-slate-400 font-mono text-sm max-w-xl mx-auto">Diagnóstico gratuito em Aveiro. Orçamento transparente antes de qualquer intervenção.</p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 font-mono text-sm">
          Falar com a Zarix →
        </a>
      </section>

    </div>
  </main>
</Layout>
