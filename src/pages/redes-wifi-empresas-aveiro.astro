---
import Layout from '../layouts/Layout.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Redes Wi-Fi para Empresas em Aveiro",
    "description": "Instalação e configuração de redes Wi-Fi empresariais em Aveiro. Cisco, Ubiquiti, VLANs e cobertura total para o seu espaço.",
    "provider": { "@id": "https://zarix.site/#business" },
    "areaServed": { "@type": "City", "name": "Aveiro" },
    "url": "https://zarix.site/redes-wifi-empresas-aveiro"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://zarix.site/" },
      { "@type": "ListItem", "position": 2, "name": "Redes Wi-Fi para Empresas em Aveiro", "item": "https://zarix.site/redes-wifi-empresas-aveiro" }
    ]
  }
];
---

<Layout
  title="Redes Wi-Fi para Empresas em Aveiro | Zarix"
  description="Instalação de redes Wi-Fi empresariais em Aveiro com Cisco e Ubiquiti. VLANs, cobertura total e segmentação de rede para clientes e sistemas internos."
  canonical="https://zarix.site/redes-wifi-empresas-aveiro"
  schema={schema}
>
  <main class="bg-[#0B0F19] text-slate-100 min-h-screen font-sans selection:bg-blue-500/30 selection:text-blue-200 relative overflow-hidden pt-24 pb-32">

    <div class="absolute inset-0 z-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_30%,#000_60%,transparent_100%)] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <nav class="mb-10 font-mono text-xs text-slate-500 flex items-center gap-2">
        <a href="/" class="hover:text-blue-400 transition-colors">Início</a>
        <span>/</span>
        <span class="text-slate-400">Redes Wi-Fi para Empresas em Aveiro</span>
      </nav>

      <section class="pb-16 border-b border-slate-800/60 space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-950 border border-slate-800 text-xs font-mono text-blue-400 tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          MOD_02 // Infraestrutura & Redes
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Redes Wi-Fi Empresariais<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-blue-500">
            em Aveiro
          </span>
        </h1>
        <p class="text-slate-400 text-base leading-relaxed max-w-2xl">
          Um Wi-Fi instável no escritório, restaurante ou loja custa dinheiro e frustra equipas e clientes. A Zarix projeta e instala redes Wi-Fi empresariais robustas em Aveiro — com cobertura total, VLANs segregadas e hardware Cisco/Ubiquiti de qualidade profissional.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/#contact" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 font-mono text-sm">
            Pedir diagnóstico de rede →
          </a>
          <a href="tel:+351967608772" class="inline-flex items-center gap-2 border border-slate-700 hover:border-blue-500/50 text-slate-300 hover:text-white font-mono text-sm py-3 px-6 rounded-lg transition-all duration-300">
            +351 967 608 772
          </a>
        </div>
      </section>

      <section class="py-16 border-b border-slate-800/60">
        <div class="mb-10 space-y-2">
          <span class="font-mono text-xs text-blue-500 uppercase tracking-widest">// O que inclui a instalação</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white">Rede profissional do início ao fim</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {[
            { title: "Auditoria de Cobertura", desc: "Análise do espaço para identificar pontos cegos e dimensionar corretamente os access points necessários." },
            { title: "Hardware Cisco / Ubiquiti", desc: "Equipamento profissional de longa duração, configurado e otimizado para o seu espaço específico." },
            { title: "VLANs Segregadas", desc: "Rede de clientes isolada da rede interna — protege os sistemas de faturação e dados sensíveis." },
            { title: "Gestão Centralizada", desc: "Painel de controlo para monitorizar dispositivos conectados, velocidades e eventuais anomalias." },
            { title: "Cablagem Estruturada", desc: "Passagem de cabos de rede certificados para garantir estabilidade e velocidade máxima em pontos fixos." },
            { title: "Portal Captivo para Clientes", desc: "Wi-Fi de clientes com autenticação personalizada para restaurantes, hotéis e espaços comerciais." },
          ].map(item => (
            <div class="p-6 bg-slate-950/50 border border-slate-800 rounded-xl hover:border-blue-500/30 transition-colors">
              <div class="w-2 h-2 rounded-full bg-blue-500 mb-4"></div>
              <h3 class="text-white font-bold mb-2">{item.title}</h3>
              <p class="text-slate-400 text-sm font-mono leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="py-16 border-b border-slate-800/60">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
          <div class="space-y-4">
            <span class="font-mono text-xs text-blue-500 uppercase tracking-widest">// Problemas que resolvemos</span>
            <h2 class="text-2xl font-bold text-white">Sinais de que a sua rede precisa de atenção</h2>
            <div class="space-y-3 font-mono text-sm text-slate-400">
              <p class="flex items-start gap-3"><span class="text-amber-400 mt-0.5">!</span> Wi-Fi cai durante horas de maior afluência</p>
              <p class="flex items-start gap-3"><span class="text-amber-400 mt-0.5">!</span> Velocidade inconsistente em diferentes zonas do espaço</p>
              <p class="flex items-start gap-3"><span class="text-amber-400 mt-0.5">!</span> Clientes na mesma rede que os sistemas de faturação</p>
              <p class="flex items-start gap-3"><span class="text-amber-400 mt-0.5">!</span> Router de casa a gerir uma empresa inteira</p>
              <p class="flex items-start gap-3"><span class="text-amber-400 mt-0.5">!</span> Nenhuma monitorização de quem está na rede</p>
            </div>
          </div>
          <div class="bg-slate-950 border border-slate-800 rounded-xl p-6 font-mono text-xs text-slate-500 space-y-3">
            <p class="text-blue-400 font-bold">$ zarix_net_scan --aveiro</p>
            <p class="text-slate-500">// Diagnóstico de infraestrutura de rede...</p>
            <p class="text-amber-400">[WARN] Router doméstico detetado em ambiente empresarial.</p>
            <p class="text-amber-400">[WARN] Clientes e sistemas internos na mesma VLAN.</p>
            <p class="text-emerald-400 font-bold">[FIX] Arquitetura empresarial Ubiquiti → estabilidade garantida.</p>
          </div>
        </div>
      </section>

      <section class="pt-16 text-center space-y-6">
        <h2 class="text-2xl md:text-3xl font-bold text-white">Rede rápida, estável e segura para o seu negócio</h2>
        <p class="text-slate-400 font-mono text-sm max-w-xl mx-auto">Diagnóstico de rede gratuito em Aveiro. Projeto e orçamento sem compromisso.</p>
        <a href="/#contact" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 font-mono text-sm">
          Falar com a Zarix →
        </a>
      </section>

    </div>
  </main>
</Layout>
